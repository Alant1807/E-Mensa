<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('bartitle'); ?>
 Bewertung
<?php $this->stopSection(); ?>

<?php $this->startSection('title'); ?>
 Bewertung für <?php echo \htmlentities($gericht['name'], ENT_QUOTES, 'UTF-8', false); ?>

<?php $this->stopSection(); ?>

<?php $this->startSection('Bild'); ?>
 <?php if($gericht['bildname'] == NULL || !file_exists("img/gerichte/" . $gericht['bildname'])): ?>
 <td ><img class="bilder" src="/img/gerichte/00_image_missing.jpg" alt="Bild des Gerichtes">
 </td>
 <?php else: ?>
 <td><img class="bilder" src="/img/gerichte/<?php echo \htmlentities($gericht['bildname'], ENT_QUOTES, 'UTF-8', false); ?>"
 alt="Bild des Gerichtes"
 ></td>
 <?php endif; ?>
<?php $this->stopSection(); ?>

<?php $this->startSection('form'); ?>
 <form method="post" action="bewertung">
 <p>Ihre Bewertung für das Gericht:</p>
 <fieldset>
 <div>
 <input type="radio" id="sehrgut" name="bewertung" value="sehr gut" checked>
 <label for="sehrgut">sehr gut</label>
 </div>
 <div>
 <input type="radio" id="gut" name="bewertung" value="gut">
 <label for="gut">gut</label>
 </div>
 <div>
 <input type="radio" id="schlecht" name="bewertung" value="schlecht">
 <label for="schlecht">schlecht</label>
 </div>
 <div>
 <input type="radio" id="sehrschlecht" name="bewertung" value="sehr schlecht">
 <label for="sehrschlecht">sehr schlecht</label>
 </div>
 </fieldset>
 <label for="review" class="labelRieview">Bemerkung</label>
 <textarea rows="5" cols="40" id="review" name="bemerkung" minlength="5"></textarea><br>
 <input type="hidden" id="gerichtid" name="gerichtID" value="<?php echo \htmlentities($gericht['id'], ENT_QUOTES, 'UTF-8', false); ?>">
 <input type="submit" name="submit" class="submit" value="Absenden">
 <input type="submit" name="back" class="mainPage" value="Hauptseite">
 </form>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('Layout.layoutBewertung'); } ?>