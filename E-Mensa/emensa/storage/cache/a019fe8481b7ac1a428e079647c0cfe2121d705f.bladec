<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('content'); ?>
 <?php if (empty($eintrag)): ?>
 Es sind keine Gerichte vorhanden
 <?php endif; ?>
 <ul>
 <?php $__currentLoopData = $eintrag; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $NameUndPreis): $loop = $this->incrementLoopIndices();  ?>
 <li>
 <?php echo \htmlentities($NameUndPreis['name'], ENT_QUOTES, 'UTF-8', false); ?>,
 <?php echo \htmlentities($NameUndPreis['preis_intern'], ENT_QUOTES, 'UTF-8', false); ?> €
 </li>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </ul>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout'); } ?>