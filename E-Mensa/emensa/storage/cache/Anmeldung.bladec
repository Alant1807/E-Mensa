<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('bartitle'); ?>
 Anmeldung
<?php $this->stopSection(); ?>

<?php $this->startSection('title'); ?>
 Anmelden
<?php $this->stopSection(); ?>

<?php $this->startSection('form'); ?>
 <form action="anmeldung_verifizieren" method="POST">
 <p><input type="email" placeholder="E-Mail" name="email"></p>
 <div class="errormessage">
 <?php if(isset($emptyuser) && $_SESSION["login_attempts"] < 3): ?>
 <?php echo \htmlentities($emptyuser, ENT_QUOTES, 'UTF-8', false); ?>

 <?php endif; ?>
 </div>
 <p><input type="password" placeholder="Passwort" name="password"></p>
 <div class="errormessage">
 <?php if(isset($emptypassword) && $_SESSION["login_attempts"] < 3): ?>
 <?php echo \htmlentities($emptypassword, ENT_QUOTES, 'UTF-8', false); ?>

 <?php endif; ?>
 </div>
 <p>
 <label>
 <input type="checkbox" name="checkadmin" id="checkadmin"> Admin
 </label>
 </p>
 <p class="submit">
 <?php if($_SESSION["login_attempts"] > 2): ?>
 Ihr Konto ist gesperrt <input type="submit" name="reset" value="Zurücksetzen">
 <?php else: ?>
 <input type="submit" name="submit" id="login" value="Anmeldung">
 <?php endif; ?>
 </p>
 <?php if(isset($msg) && !isset($emptyuser) && !isset($emptypassword) && $_SESSION["login_attempts"] < 3): ?>
 <div class="errormessage"><?php echo \htmlentities($msg, ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php endif; ?>
 <?php if(isset($login_fail_admin) && $_SESSION["login_attempts"] < 3): ?>
 <div class="errormessage"><?php echo \htmlentities($login_fail_admin, ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php endif; ?>
 </form>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('Layout.layoutAnmeldung'); } ?>