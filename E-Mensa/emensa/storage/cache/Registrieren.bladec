 <?php elseif(isset($emptyuser)): ?>
 <?php echo \htmlentities($emptyuser, ENT_QUOTES, 'UTF-8', false); ?>

 <?php endif; ?>
 </div>
 <label for="pass">Passwort:</label>
 <input type="password" id="pass" name="password">
 <div class="errormessage">
 <?php if(isset($emptypassword)): ?>
 <?php echo \htmlentities($emptypassword, ENT_QUOTES, 'UTF-8', false); ?>

 <?php endif; ?>
 </div>
 <input type="checkbox" name="checkadmin"> Admin
 <input type="submit" name="submit" value="Registrieren">
 </form>
<?php $this->stopSection(); ?>

