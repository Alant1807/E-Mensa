<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('bartitle'); ?>
 Meine Bewertungen
<?php $this->stopSection(); ?>

<?php $this->startSection('title'); ?>
 <div class="title">
 <h3> Meine Bewertungen </h3>
 </div>
<?php $this->stopSection(); ?>

<?php $this->startSection('content'); ?>
 <form method="post" action="meinebewertungen" class="container">
 <table>
 <thead>
 <tr>
 <th>Gericht</th>
 <th>Sternebewertung</th>
 <th>Bemerkung</th>
 <th>Bewertungszeitraum</th>
 <th>Markieren</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $bewertungen; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $bewertung): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td><?php echo \htmlentities($bewertung['name'], ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($bewertung['sternebewertung'], ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($bewertung['bemerkung'], ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($bewertung['bewertungszeitpunkt'], ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><input type="checkbox" name="delete[]" value="<?php echo \htmlentities($bewertung['id'], ENT_QUOTES, 'UTF-8', false); ?>"></td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </tbody>
 </table>
 <input type="submit" name="back" value="Hauptseite" class="buttonMain">
 <input type="submit" name="submitdelete" value="löschen" class="buttonSubmit">
 </form>
<?php $this->stopSection(); ?>
<?php if (isset($_shouldextend[1])) { echo $this->runChild('Layout.layoutmeineBewertungen'); } ?>