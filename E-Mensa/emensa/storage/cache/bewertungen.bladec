<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('bartitle'); ?>
 Bewertungen
<?php $this->stopSection(); ?>

<?php $this->startSection('title'); ?>
 Die aktuellsten Bewertungen
<?php $this->stopSection(); ?>

<?php $this->startSection('content'); ?>
 <form method="post" action="bewertungen">
 <table>
 <thead>
 <tr>
 <th>Gericht</th>
 <th>Sternenbewertung</th>
 <th>Bemerkung</th>
 <th>Bewertungszeitraum</th>
 <th>Kunde</th>
 <?php if($userinfo['admin'] == 1): ?>
 <th>Hervorhebung</th>
 <?php endif; ?>
 </tr>
 </thead>
 <tbody>
 <?php if($userinfo['admin'] == 0): ?>
 <?php $__currentLoopData = $bewertungen; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $bewertung): $loop = $this->incrementLoopIndices();  ?>
 <tr class="<?php if($bewertung['hervorgehoben']): ?>
 marked
 <?php endif; ?>
 ">
 <td><?php echo \htmlentities($bewertung['name'], ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($bewertung['sternebewertung'], ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($bewertung['bemerkung'], ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($bewertung['bewertungszeitpunkt'], ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($bewertung['kunde'], ENT_QUOTES, 'UTF-8', false); ?></td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php else: ?>
 <?php $__currentLoopData = $bewertungen; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $bewertung): $loop = $this->incrementLoopIndices();  ?>
 <tr class="<?php if($bewertung['hervorgehoben']): ?>
 marked
 <?php endif; ?>
 ">
 <td><?php echo \htmlentities($bewertung['name'], ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($bewertung['sternebewertung'], ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($bewertung['bemerkung'], ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($bewertung['bewertungszeitpunkt'], ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($bewertung['kunde'], ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php if($bewertung['hervorgehoben']): ?>
 <a  href="/bewertungen?bewertungsid=<?php echo \htmlentities($bewertung['id'], ENT_QUOTES, 'UTF-8', false); ?>" onclick="<meta http-equiv='refresh' content='0'>">
 Hervorhebung Auflösen
 </a>
 <?php else: ?>
 <a  href="/bewertungen?bewertungsid=<?php echo \htmlentities($bewertung['id'], ENT_QUOTES, 'UTF-8', false); ?>" onclick="<meta http-equiv='refresh' content='0'>">
 Hervorheben
 </a>
 <?php endif; ?>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </tbody>
 </table>
 <input type="submit" name="back" value="Hauptseite">
 </form>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('Layout.layoutBewertungen'); } ?>